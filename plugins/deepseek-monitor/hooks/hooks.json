{
  "description": "Load the installed deepseek-helper rules for Harness and ZCode before each user task; Codex decides whether to delegate. The hook does not call external models.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/task-preflight.mjs\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 5,
            "additionalContextLimit": 0,
            "statusMessage": "加载 DeepSeek 协作规则，评估本次任务分工"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(resume|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/task-preflight.mjs\"",
            "commandWindows": "powershell.exe -NoLogo -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 5,
            "additionalContextLimit": 0,
            "statusMessage": "恢复 DeepSeek 协作规则"
          }
        ]
      }
    ]
  }
}
